{
  "name": "jig-dialer",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "jig-dialer", "database_id": "5121d769-cbf0-49a5-8b3e-5b0d87e1abc2" }
  ]
}
