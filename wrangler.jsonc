{
  "name": "jig-dialer",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "jig-dialer", "database_id": "YOUR-EXISTING-ID-STAYS-HERE" }
  ],
  "vars": {
    "SW_FROM": "+12816195836",
    "SW_PROJECT_ID": "cb9a913b-4b0a-4dac-9f0c-c8125d7b3f3e",
    "SW_SPACE": "jackson-investments-group.signalwire.com"
  }
}
